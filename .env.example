# RAFAY hidden admin URL key. Use a random value at least 24 characters long.
# Never commit the real production value.
RAFAY_ADMIN_KEY=replace-with-a-long-random-secret

# Vercel Blob read/write token used for site data, bookings and profile media.
# Create/connect a Blob store in Vercel and copy its environment token here for local development.
BLOB_READ_WRITE_TOKEN=replace-with-vercel-blob-token
