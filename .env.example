# RAFAY hidden admin URL key. Use a random value at least 24 characters long.
# Never commit the real production value.
RAFAY_ADMIN_KEY=replace-with-a-long-random-secret

# Optional persistent filesystem backend (recommended on Railway).
# Set this to the absolute persistent-volume mount path, e.g. /data.
# When set, RAFAY stores site config, bookings and media here and does not require Vercel Blob.
RAFAY_DATA_DIR=

# PUBLIC Vercel Blob store used for site configuration, hero/logo media and profile images
# when RAFAY_DATA_DIR is not set. On Vercel, a connected public Blob store can authenticate
# through OIDC automatically. This static token is useful for local development or token-based connections.
BLOB_READ_WRITE_TOKEN=replace-with-public-vercel-blob-token

# PRIVATE Vercel Blob store used only for booking request records when RAFAY_DATA_DIR is not set.
# Keep this as the read/write token from a separate private Blob store.
RAFAY_PRIVATE_BLOB_READ_WRITE_TOKEN=replace-with-private-vercel-blob-token
